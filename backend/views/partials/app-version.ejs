<div class="app-version-badge" aria-label="نسخه سامانه FoodMood">
  <span class="app-version-label">نسخه</span>
  <span class="app-version-number"><%= appVersionFa %></span>
  <% if (typeof previousAppVersionFa !== 'undefined' && previousAppVersionFa && previousAppVersionFa !== appVersionFa) { %>
    <span class="app-version-detail">(قبلی: <%= previousAppVersionFa %>)</span>
  <% } %>
</div>
