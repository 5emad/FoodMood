<%
  const code = Number(locals.statusCode || 404);
  const PRESETS = {
    404: { title: 'صفحه پیدا نشد', text: 'آدرسی که وارد کرده‌اید وجود ندارد، حذف شده یا جابه‌جا شده است.' },
    403: { title: 'دسترسی غیرمجاز', text: 'شما اجازه‌ی مشاهده‌ی این بخش را ندارید. اگر فکر می‌کنید اشتباهی رخ داده، با مدیر سامانه تماس بگیرید.' },
    400: { title: 'درخواست نامعتبر', text: 'درخواست ارسال‌شده قابل پردازش نبود. لطفاً دوباره تلاش کنید.' },
  };
  const preset = PRESETS[code] || PRESETS[400];
  const title = locals.title || preset.title;
  const text = locals.message || preset.text;
  const role = String((locals.user && locals.user.role) || '').toLowerCase();
  const home = role === 'admin' || role === 'superadmin' ? '/admin/reports' : (locals.user ? '/user/dashboard' : '/login');
  const homeLabel = locals.user ? 'بازگشت به داشبورد' : 'ورود به سامانه';
  const faCode = String(code).replace(/\d/g, (d) => '۰۱۲۳۴۵۶۷۸۹'[d]);
%><!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex">
  <title><%= title %> | <%= faCode %></title>
  <link rel="icon" href="/img/logo.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/vendor/vazirmatn/vazirmatn.css">
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    html, body { margin: 0; min-height: 100%; }
    body {
      font-family: Vazirmatn, Tahoma, sans-serif; direction: rtl; color: #17203d;
      min-height: 100vh; min-height: 100dvh; display: flex; flex-direction: column;
      background:
        radial-gradient(1100px 560px at 78% 10%, rgba(77, 115, 181, .45) 0%, transparent 60%),
        radial-gradient(800px 500px at 6% 95%, rgba(245, 179, 1, .12) 0%, transparent 60%),
        linear-gradient(160deg, #1b3f8d 0%, #132f6e 50%, #0b1a3d 100%);
    }
    main { flex: 1; display: flex; align-items: center; justify-content: center; padding: 32px 16px; }
    .card {
      width: min(560px, 100%); background: #fff; border-radius: 22px; padding: 34px 28px 30px;
      box-shadow: 0 28px 70px rgba(5, 12, 40, .35); text-align: center; animation: rise .25s ease-out;
    }
    .art { width: 190px; height: 150px; margin: 0 auto 6px; display: block; }
    .code {
      font-size: 3.4rem; font-weight: 900; line-height: 1; letter-spacing: 2px; margin: 0 0 8px;
      background: linear-gradient(135deg, #4d73b5, #1b3f8d 60%, #122a62); -webkit-background-clip: text; background-clip: text; color: transparent;
    }
    h1 { font-size: 1.3rem; margin: 0 0 10px; color: #1b3f8d; font-weight: 800; }
    p { margin: 0 auto 24px; color: #4a5476; line-height: 1.9; font-size: .95rem; max-width: 420px; }
    .actions { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 46px; padding: 0 22px;
      border-radius: 12px; font: inherit; font-weight: 700; font-size: .95rem; text-decoration: none; cursor: pointer;
      border: 1.5px solid transparent; transition: background .15s, box-shadow .15s;
    }
    .btn-primary { background: #1b3f8d; color: #fff; box-shadow: 0 6px 18px rgba(27, 63, 141, .3); }
    .btn-primary:hover { background: #122a62; }
    .btn-outline { background: #fff; color: #1b3f8d; border-color: #c3cbe2; }
    .btn-outline:hover { background: #e8edf8; }
    .btn:focus-visible { outline: 3px solid rgba(245, 179, 1, .7); outline-offset: 2px; }
    .brand { display: flex; align-items: center; justify-content: center; gap: 10px; color: rgba(255, 255, 255, .85); font-size: .85rem; padding: 0 0 22px; }
    .brand img { width: 26px; height: 26px; border-radius: 7px; }
    @keyframes rise { from { opacity: 0; transform: translateY(10px); } }
    @media (max-width: 480px) { .card { padding: 26px 18px 22px; } .code { font-size: 2.8rem; } .actions .btn { flex: 1 1 100%; } }
    @media (prefers-reduced-motion: reduce) { .card { animation: none; } }
  </style>
</head>
<body>
  <main>
    <section class="card" aria-labelledby="err-title">
      <% if (code === 403) { %>
      <svg class="art" viewBox="0 0 190 150" aria-hidden="true">
        <ellipse cx="95" cy="138" rx="62" ry="7" fill="#e8edf8"/>
        <path d="M95 14 150 34v38c0 33-24 55-55 64-31-9-55-31-55-64V34z" fill="#e8edf8" stroke="#c3cbe2" stroke-width="3"/>
        <path d="M95 26 140 42v30c0 26-19 44-45 52-26-8-45-26-45-52V42z" fill="#1b3f8d"/>
        <rect x="74" y="68" width="42" height="34" rx="7" fill="#fff"/>
        <path d="M82 68v-9a13 13 0 0 1 26 0v9" fill="none" stroke="#fff" stroke-width="6" stroke-linecap="round"/>
        <circle cx="95" cy="82" r="5" fill="#1b3f8d"/><rect x="92.5" y="84" width="5" height="10" rx="2.5" fill="#1b3f8d"/>
        <circle cx="158" cy="22" r="6" fill="#f5b301"/><circle cx="28" cy="40" r="4" fill="#4d73b5" opacity=".5"/>
      </svg>
      <% } else { %>
      <svg class="art" viewBox="0 0 190 150" aria-hidden="true">
        <ellipse cx="95" cy="138" rx="66" ry="7" fill="#e8edf8"/>
        <circle cx="95" cy="80" r="52" fill="#e8edf8" stroke="#c3cbe2" stroke-width="3"/>
        <circle cx="95" cy="80" r="36" fill="#fff" stroke="#dde3f0" stroke-width="3"/>
        <path d="M84 70a11 11 0 1 1 15 10c-3 2-4 4-4 7" fill="none" stroke="#1b3f8d" stroke-width="6" stroke-linecap="round"/>
        <circle cx="95" cy="98" r="4" fill="#1b3f8d"/>
        <g fill="none" stroke="#4d73b5" stroke-width="5" stroke-linecap="round"><path d="M28 40v38"/><path d="M22 40v14a6 6 0 0 0 12 0V40"/></g>
        <path d="M162 40c-8 4-10 16-10 24h10v14" fill="none" stroke="#4d73b5" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
        <g fill="none" stroke="#f5b301" stroke-width="4" stroke-linecap="round"><path d="M86 22c-4-4 4-7 0-12"/><path d="M104 22c-4-4 4-7 0-12"/></g>
      </svg>
      <% } %>
      <div class="code" aria-hidden="true"><%= faCode %></div>
      <h1 id="err-title"><%= title %></h1>
      <p><%= text %></p>
      <div class="actions">
        <a class="btn btn-primary" href="<%= home %>"><%= homeLabel %></a>
        <% if (code === 403 && locals.user) { %>
        <a class="btn btn-outline" href="/logout">ورود با حساب دیگر</a>
        <% } %>
      </div>
    </section>
  </main>
  <div class="brand"><img src="/img/logo.svg" alt=""><span><%= locals.organizationName || 'سامانه تغذیه' %></span></div>
</body>
</html>
